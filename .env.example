# Public site
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# /dashboard (YouTube analytics, internal)
# Supabase -> Project Settings -> API -> service_role. Server only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Google Cloud -> YouTube Data API v3 key (free, 10,000 units/day)
YOUTUBE_API_KEY=
# Shared login password for the team, and a random 32+ char string that signs the session cookie
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=
# Vercel Cron sends this as a Bearer token to /api/dashboard/sync (daily, 05:00 WIB)
CRON_SECRET=
